{
  "name": "@iampopovich/gog-countries-mcp",
  "version": "1.0.0",
  "description": "MCP server for GOG.com game prices across countries",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gog-countries-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gog",
    "gog-com",
    "games",
    "game-prices",
    "prices",
    "countries",
    "typescript",
    "llm-integration",
    "ai-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iampopovich/gog-mcp-server.git"
  },
  "homepage": "https://github.com/iampopovich/gog-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/iampopovich/gog-mcp-server/issues"
  },
  "author": "iampopovich",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^9.39.4",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  }
}
